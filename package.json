{
  "name": "ti-basic",
  "displayName": "TI-BASIC",
  "version": "1.0.4",
  "description": "VS Code language support for (e)Z80 TI-BASIC",
  "author": {
    "name": "Lucas Lavallee"
  },
  "publisher": "LucasLavalleeMA",
  "license": "BSD-3-Clause",
  "icon": "assets/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasLavalleeMA/language-ti-basic.git"
  },
  "bugs": {
    "url": "https://github.com/LucasLavalleeMA/language-ti-basic/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ti-basic",
        "aliases": [
          "TI-BASIC",
          "ti-basic"
        ],
        "extensions": [
          ".8xp",
          ".8xp.txt",
          ".83p",
          ".83p.txt"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "assets/ti-basic-file.svg",
          "dark": "assets/ti-basic-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ti-basic",
        "scopeName": "source.8xp",
        "path": "./syntaxes/ti-basic.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ti-basic",
        "path": "snippets/tibasic.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "extension.importTIBasic",
        "title": "Import TI-BASIC Program"
      },
      {
        "command": "extension.exportTIBasic",
        "title": "Export TI-BASIC Program"
      },
      {
        "command": "extension.setTIBasicDestination",
        "title": "Set TI-BASIC Export Destination Folder"
      },
      {
        "command": "extension.exportActiveTIBasic",
        "title": "Export Active TI-BASIC File"
      },
      {
        "command": "extension.exportFolderTIBasic",
        "title": "Export All TI-BASIC Files in Folder"
      }
    ]
  },
  "scripts": {},
  "devDependencies": {
    "@types/vscode": "^1.73.0"
  }
}
